# Neo4j
# Local Docker: bolt://localhost:7687
# AuraDB:      neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password
NEO4J_DATABASE=neo4j

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# Optional Cohere reranker
COHERE_API_KEY=
USE_COHERE_RERANK=false

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*

# RAG tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=12
RERANK_TOP_K=5
HYBRID_ALPHA=0.65
MAX_CONTEXT_TOKENS=6000

# Guardrails
GUARDRAIL_MAX_INPUT_CHARS=4000
GUARDRAIL_BLOCK_PII=true
GUARDRAIL_REQUIRE_CITATIONS=true
GUARDRAIL_REFUSAL_ON_LOW_CONFIDENCE=true
GUARDRAIL_MIN_RELEVANCE=0.20

# AWS / Observability
AWS_REGION=us-east-1
AWS_CLOUDWATCH_NAMESPACE=FinanceRAG/SourceAdvisors
OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_PROMETHEUS=true
